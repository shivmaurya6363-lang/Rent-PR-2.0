# ---------------------------------------------------------------------------
# RentPR environment. Copy to .env.local for development; set these in your
# host's environment settings for production. Never commit real values.
# ---------------------------------------------------------------------------

# --- Supabase (browser-safe: the publishable key is designed to be public) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_PROJECT_ID=

# --- Public site URL (canonical links, payment redirects) ---
NEXT_PUBLIC_SITE_URL=https://rentpr.in

# --- SERVER ONLY. These must never be exposed to the browser. ---
# Service-role key: bypasses row level security. Used only after authenticating the caller.
SUPABASE_SERVICE_ROLE_KEY=
# Postgres connection string (Supabase > Project Settings > Database > Connection pooling).
# Billing runs multi-statement transactions that the REST API cannot.
DATABASE_URL=

# --- Razorpay (recurring subscriptions) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# The secret you set on the webhook in the Razorpay dashboard (different from the key secret).
# Webhooks fail closed (401) when this is missing.
RAZORPAY_WEBHOOK_SECRET=

# --- PhonePe (optional; existing integration) ---
PHONEPE_MERCHANT_ID=
PHONEPE_SALT_KEY=
PHONEPE_SALT_INDEX=1
# sandbox | production
PHONEPE_ENV=sandbox

# --- Scheduler ---
# Protects /api/cron/billing. Min 16 characters. Vercel Cron sends it automatically.
CRON_SECRET=

# --- Notifications (optional) ---
# Without these, notices are recorded in the account and email is logged as "skipped_no_provider".
RESEND_API_KEY=
NOTIFY_FROM_EMAIL=

# --- Tests only ---
# TEST_DATABASE_URL=postgres://postgres@localhost:5432/rentpr_test   (see scripts/test-db.sh)
